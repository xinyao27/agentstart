    "@xterm/addon-serialize": "catalog:",
    "@xterm/addon-unicode11": "catalog:workbench",
    "@xterm/addon-web-links": "catalog:",
    "@xterm/addon-webgl": "catalog:workbench",
    "@xterm/xterm": "catalog:workbench",
    "@yiru/protocol": "workspace:*",
    "babel-plugin-react-compiler": "catalog:",
    "class-variance-authority": "catalog:",
    "cmdk": "catalog:",
    "cnfast": "catalog:",
