{
  "name": "@yiru/client",
  "version": "0.0.1",
  "private": true,
  "description": "Yiru source-only browser workbench consumed through declared host exports",
  "type": "module",
  "sideEffects": [
    "./src/assets/main.css"
  ],
  "exports": {
    "./extension-bootstrap": "./src/extension/bootstrap.ts",
    "./extension-devtools": "./src/extension/devtools/bootstrap.tsx",
    "./extension-install": "./src/extension/install/bootstrap.tsx",
    "./extension-settings": "./src/extension/settings/bootstrap.tsx",
    "./styles": "./src/assets/main.css",
    "./vite": "./vite.ts",
    "./pdf-export": "./src/extension/pdf-export.ts",
    "./notifications": "./src/extension/notification-request.ts"
  },
  "scripts": {
    "fmt": "vp fmt .",
    "lint": "vp lint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@floating-ui/dom": "catalog:",
