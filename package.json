{
  "name": "@yiru/workspace",
  "version": "0.0.36",
  "private": true,
  "description": "Yiru monorepo workspace",
  "homepage": "https://github.com/xinyao27/yiru#readme",
  "bugs": {
    "url": "https://github.com/xinyao27/yiru/issues"
  },
  "license": "MIT",
  "author": {
    "name": "xinyao",
    "email": "hi@xinyao.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinyao27/yiru.git"
  },
  "funding": "https://github.com/sponsors/xinyao27",
  "type": "module",
  "scripts": {
    "dev": "vp run --parallel --filter @yiru/daemon --filter @yiru/extension dev",
    "build": "vp run --filter @yiru/daemon --filter @yiru/extension --filter @yiru/apns-gateway build",
    "typecheck": "vp run --cache -r typecheck",
    "check": "vp run @yiru/daemon#fmt && vp check --fix && vp run typecheck && vp run @yiru/daemon#lint",
    "lint": "vp lint --fix",
    "fmt": "vp fmt",
    "package:macos": "node scripts/build-macos-app.mjs",
    "release": "node scripts/release.mjs",
    "release:setup": "bash scripts/release-setup.sh",
    "up": "taze major -Ir --ignore-paths apps/mobile/build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxlint-plugin-react-doctor": "catalog:",
    "taze": "catalog:",
    "typescript": "catalog:",
    "typescript-api": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@12.1.0"
}
