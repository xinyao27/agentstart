# AgentStart native iOS release lane. It signs and uploads the only mobile client while
# refusing to target any App Store Connect record other than the configured AgentStart app.

require "base64"
require "open3"
require "plist"
require "tmpdir"

default_platform(:ios)

MOBILE_ROOT = File.expand_path("..", __dir__)
PROJECT = File.join(MOBILE_ROOT, "AgentStartMobile.xcodeproj")
BUILD_OUTPUT_DIRECTORY = File.join(MOBILE_ROOT, "build")
SCHEME = "AgentStartMobile"
APP_TARGET = "AgentStartMobile"
BUNDLE_ID = "com.xinyao27.agentstart.mobile"
APP_STORE_APP_ID = "6810343597"
APPLE_TEAM_ID = "8H6Q2YA365"
WIDGET_TARGET = "AgentStartWidgets"
WIDGET_BUNDLE_ID = "com.xinyao27.agentstart.mobile.Widgets"
APP_GROUP_ID = "group.com.xinyao27.agentstart.mobile"
TESTFLIGHT_GROUPS = ["peeps"].freeze
DEFAULT_TESTFLIGHT_CHANGELOG = "Latest AgentStart Mobile updates and fixes.".freeze
CLOSED_APP_STORE_STATES = %w[
  READY_FOR_SALE
  PENDING_DEVELOPER_RELEASE
  PENDING_APPLE_RELEASE
  REPLACED_WITH_NEW_VERSION
  REMOVED_FROM_SALE
  DEVELOPER_REMOVED_FROM_SALE
].freeze

def app_store_connect_api_key_from_env
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_API_KEY_P8"),
    is_key_content_base64: true,
    in_house: false,
  )
end

def release_history(app)
  app_store_versions = app
    .get_app_store_versions(filter: { platform: Spaceship::ConnectAPI::Platform::IOS })
    .map(&:version_string)
  builds = Spaceship::ConnectAPI::Build.all(
    app_id: app.id,
    platform: Spaceship::ConnectAPI::Platform::IOS,
  )

  {
    versions: (app_store_versions + builds.map(&:app_version)).compact.uniq,
    build_numbers: builds.map { |build| build.version.to_s },
  }
rescue StandardError => error
  UI.user_error!(
    "Could not read version and build history from the configured AgentStart App Store app; " \
    "release blocked (#{error.message})",
  )
end

def resolve_requested_version(options)
  requested = options[:version].to_s.strip
  requested = ENV.fetch("MOBILE_RELEASE_VERSION", "").strip if requested.empty?
  unless requested.match?(/\A\d+\.\d+\.\d+\z/)
    UI.user_error!("iOS release requires an exact x.y.z version")
  end
  requested
end

def version_train_closed?(app, version)
  return false unless app

  app
    .get_app_store_versions(filter: { versionString: version })
    .any? do |app_store_version|
      CLOSED_APP_STORE_STATES.include?(app_store_version.app_store_state)
    end
rescue StandardError => error
  UI.user_error!(
    "Could not determine App Store state for #{version}; release blocked (#{error.message})",
  )
end

def configured_app_store_app!
  app_store_app_id = ENV.fetch("APP_STORE_APP_ID").strip
  unless app_store_app_id.match?(/\A[1-9]\d*\z/)
    UI.user_error!("APP_STORE_APP_ID must be the numeric ID of the AgentStart App Store record")
  end
  unless app_store_app_id == APP_STORE_APP_ID
    UI.user_error!(
      "APP_STORE_APP_ID must identify the AgentStart App Store record #{APP_STORE_APP_ID}; " \
      "received #{app_store_app_id}",
    )
  end
  app =
    begin
      Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    rescue StandardError => error
      UI.user_error!(
        "Could not verify the configured AgentStart App Store app #{BUNDLE_ID}; release blocked " \
        "(#{error.message})",
      )
    end

  unless app
    UI.user_error!("Configured AgentStart App Store app #{BUNDLE_ID} was not found; release blocked")
  end
  unless app.id == app_store_app_id
    UI.user_error!(
      "App Store record mismatch for #{BUNDLE_ID}: expected Apple ID #{app_store_app_id}, " \
      "received #{app.id}; release blocked",
    )
  end

  UI.message("Verified AgentStart App Store app #{BUNDLE_ID} (Apple ID #{app_store_app_id})")
  app
end

def configured_apple_team_id!
  team_id = ENV.fetch("APPLE_TEAM_ID").strip
  unless team_id == APPLE_TEAM_ID
    UI.user_error!("APPLE_TEAM_ID must identify the AgentStart team #{APPLE_TEAM_ID}")
  end
  team_id
end

def ensure_open_version_train!(app, version)
  return unless version_train_closed?(app, version)

  UI.user_error!(
    "iOS version #{version} is already submitted or released. Provide a higher release_version.",
  )
end

def next_testflight_build_number(history)
  build_numbers = history
    .fetch(:build_numbers)
    .select { |build_number| build_number.match?(/\A[1-9]\d*\z/) }
    .map(&:to_i)

  build_numbers.max.to_i + 1
end

def testflight_changelog
  changelog = ENV.fetch("TESTFLIGHT_CHANGELOG", "").strip
  changelog.empty? ? DEFAULT_TESTFLIGHT_CHANGELOG : changelog
end

def testflight_distribution
  distribution = ENV.fetch("TESTFLIGHT_DISTRIBUTION", "internal").strip.downcase
  return distribution if %w[internal external].include?(distribution)

  UI.user_error!("TESTFLIGHT_DISTRIBUTION must be 'internal' or 'external'")
end

def resolve_archive_build_number(options, history)
  requested = options[:build_number].to_s.strip
  requested = ENV.fetch("NATIVE_ARCHIVE_BUILD_NUMBER", "").strip if requested.empty?
  requested = next_testflight_build_number(history).to_s if requested.empty?

  unless requested.match?(/\A[1-9]\d*\z/)
    UI.user_error!("Archive build number must be a positive integer")
  end
  requested
end

def generate_project
  Dir.chdir(MOBILE_ROOT) do
    sh("xcodegen", "generate")
  end
end

def signed_entitlements(bundle_path)
  stdout, stderr, status = Open3.capture3(
    "codesign",
    "--display",
    "--entitlements",
    "-",
    "--xml",
    bundle_path,
  )
  unless status.success?
    UI.user_error!("Could not read signed entitlements for #{bundle_path}: #{stderr.strip}")
  end
  entitlements = Plist.parse_xml(stdout)
  unless entitlements.is_a?(Hash)
    UI.user_error!("Signed entitlements are missing from #{bundle_path}")
  end
  entitlements
end

def verify_signed_bundle(
  bundle_path:,
  bundle_id:,
  team_id:,
  version:,
  build_number:,
  needs_app_group:
)
  sh("codesign", "--verify", "--strict", bundle_path)
  info = Plist.parse_xml(File.join(bundle_path, "Info.plist"))
  unless info.is_a?(Hash) && info["CFBundleIdentifier"] == bundle_id
    UI.user_error!("Signed bundle identifier mismatch for #{bundle_path}; expected #{bundle_id}")
  end
  unless info["CFBundleShortVersionString"] == version && info["CFBundleVersion"] == build_number
    UI.user_error!(
      "Signed bundle version mismatch for #{bundle_id}; expected #{version} (#{build_number})",
    )
  end

  entitlements = signed_entitlements(bundle_path)
  application_identifier = entitlements["application-identifier"]
  unless application_identifier.is_a?(String) && application_identifier.end_with?(".#{bundle_id}")
    UI.user_error!("Signed application identifier does not authorize #{bundle_id}")
  end
  unless entitlements["com.apple.developer.team-identifier"] == team_id
    UI.user_error!("Signed Team ID does not match #{team_id} for #{bundle_id}")
  end
  if needs_app_group && !Array(entitlements["com.apple.security.application-groups"]).include?(APP_GROUP_ID)
    UI.user_error!("Signed profile does not authorize App Group #{APP_GROUP_ID} for #{bundle_id}")
  end
end

def verify_signed_app(app:, team_id:, version:, build_number:)
  verify_signed_bundle(
    bundle_path: app,
    bundle_id: BUNDLE_ID,
    team_id: team_id,
    version: version,
    build_number: build_number,
    needs_app_group: true,
  )
  app_entitlements = signed_entitlements(app)
  if app_entitlements.key?("aps-environment")
    UI.user_error!("Signed AgentStart app unexpectedly includes remote notification entitlement")
  end
  embedded_extensions = Dir.glob(File.join(app, "PlugIns", "*.appex"))
  expected_widget = File.join(app, "PlugIns", "AgentStartWidgets.appex")
  unless embedded_extensions == [expected_widget]
    UI.user_error!("Signed AgentStart app must contain only the widget extension")
  end
  verify_signed_bundle(
    bundle_path: expected_widget,
    bundle_id: WIDGET_BUNDLE_ID,
    team_id: team_id,
    version: version,
    build_number: build_number,
    needs_app_group: true,
  )
  unless File.file?(File.join(app, "PrivacyInfo.xcprivacy")) &&
      File.file?(File.join(expected_widget, "PrivacyInfo.xcprivacy"))
    UI.user_error!("Signed AgentStart product is missing a required privacy manifest")
  end
end

def verify_signed_archive(team_id:, version:, build_number:)
  app = File.join(
    BUILD_OUTPUT_DIRECTORY,
    "AgentStart.xcarchive",
    "Products",
    "Applications",
    "AgentStart.app",
  )
  verify_signed_app(app: app, team_id: team_id, version: version, build_number: build_number)
  UI.message("Verified AgentStart archive identities, versions, entitlements, and privacy manifests")
end

def verify_exported_ipa(ipa_path:, team_id:, version:, build_number:)
  unless ipa_path.is_a?(String) && File.file?(ipa_path)
    UI.user_error!("AgentStart IPA export is missing")
  end

  Dir.mktmpdir("agentstart-ipa-") do |directory|
    _stdout, stderr, status = Open3.capture3("ditto", "-x", "-k", ipa_path, directory)
    unless status.success?
      UI.user_error!("Could not inspect exported AgentStart IPA: #{stderr.strip}")
    end
    apps = Dir.glob(File.join(directory, "Payload", "*.app"))
    unless apps.length == 1
      UI.user_error!("AgentStart IPA must contain exactly one application bundle")
    end
    verify_signed_app(
      app: apps.fetch(0),
      team_id: team_id,
      version: version,
      build_number: build_number,
    )
  end
  UI.message("Verified exported AgentStart IPA identities, versions, entitlements, and privacy manifests")
end

def build_signed_archive(api_key:, version:, build_number:, team_id:, force_profiles:)
  app_profile = get_provisioning_profile(
    api_key: api_key,
    app_identifier: BUNDLE_ID,
    force: force_profiles,
  )
  app_profile_name = lane_context[SharedValues::SIGH_NAME]
  unless app_profile_name
    UI.user_error!("Could not resolve app provisioning profile #{app_profile}")
  end

  widget_profile = get_provisioning_profile(
    api_key: api_key,
    app_identifier: WIDGET_BUNDLE_ID,
    force: force_profiles,
  )
  widget_profile_name = lane_context[SharedValues::SIGH_NAME]
  unless widget_profile_name
    UI.user_error!("Could not resolve widget provisioning profile #{widget_profile}")
  end

  generate_project
  update_code_signing_settings(
    path: PROJECT,
    use_automatic_signing: false,
    team_id: team_id,
    targets: [APP_TARGET],
    build_configurations: ["Release"],
    code_sign_identity: "Apple Distribution",
    profile_name: app_profile_name,
  )
  update_code_signing_settings(
    path: PROJECT,
    use_automatic_signing: false,
    team_id: team_id,
    targets: [WIDGET_TARGET],
    build_configurations: ["Release"],
    code_sign_identity: "Apple Distribution",
    profile_name: widget_profile_name,
  )
  ipa_path = build_app(
    project: PROJECT,
    scheme: SCHEME,
    configuration: "Release",
    # Why: fastlane 2.237 still validates the legacy spelling, while Xcode maps it to the current
    # App Store Connect distribution method. Keep the export plist otherwise explicit below.
    export_method: "app-store",
    export_options: {
      manageAppVersionAndBuildNumber: false,
      teamID: team_id,
      signingStyle: "manual",
      provisioningProfiles: {
        BUNDLE_ID => app_profile_name,
        WIDGET_BUNDLE_ID => widget_profile_name,
      },
    },
    xcargs: "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number}",
    archive_path: File.join(BUILD_OUTPUT_DIRECTORY, "AgentStart.xcarchive"),
    output_directory: BUILD_OUTPUT_DIRECTORY,
    output_name: "AgentStart.ipa",
    clean: true,
  )
  verify_signed_archive(team_id: team_id, version: version, build_number: build_number)
  verify_exported_ipa(
    ipa_path: ipa_path,
    team_id: team_id,
    version: version,
    build_number: build_number,
  )
end

platform :ios do
  desc "Validate the requested native iOS version and report its next TestFlight build number"
  lane :prepare_release_version do |options|
    app_store_connect_api_key_from_env
    app = configured_app_store_app!
    history = release_history(app)
    version = resolve_requested_version(options)
    ensure_open_version_train!(app, version)
    build_number = next_testflight_build_number(history)
    UI.message("Prepared AgentStart Mobile #{version} (#{build_number})")
  end

  desc "Build and export a signed native archive without uploading it"
  lane :archive do |options|
    api_key = app_store_connect_api_key_from_env
    team_id = configured_apple_team_id!
    app = configured_app_store_app!
    history = release_history(app)
    version = resolve_requested_version(options)
    build_number = resolve_archive_build_number(options, history)

    build_signed_archive(
      api_key: api_key,
      version: version,
      build_number: build_number,
      team_id: team_id,
      force_profiles: false,
    )
    UI.success("Archived AgentStart Mobile #{version} (#{build_number}) without upload")
  end

  desc "Build, sign, upload, and distribute the native iOS app through TestFlight"
  lane :release do |options|
    api_key = app_store_connect_api_key_from_env
    app = configured_app_store_app!
    history = release_history(app)
    version = resolve_requested_version(options)
    ensure_open_version_train!(app, version)
    build_number = next_testflight_build_number(history)
    distribution = testflight_distribution
    team_id = configured_apple_team_id!

    build_signed_archive(
      api_key: api_key,
      version: version,
      build_number: build_number,
      team_id: team_id,
      force_profiles: true,
    )
    if distribution == "external"
      upload_to_testflight(
        api_key: api_key,
        skip_waiting_for_build_processing: false,
        distribute_external: true,
        groups: TESTFLIGHT_GROUPS,
        notify_external_testers: true,
        changelog: testflight_changelog,
      )
    else
      upload_to_testflight(
        api_key: api_key,
        skip_waiting_for_build_processing: true,
        distribute_external: false,
      )
    end

    UI.success("Uploaded AgentStart Mobile #{version} (#{build_number})")
  end
end
