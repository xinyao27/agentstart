{
  "name": "@agentstart/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension host for AgentStart workspaces",
  "homepage": "https://github.com/xinyao27/agentstart#readme",
  "bugs": {
    "url": "https://github.com/xinyao27/agentstart/issues"
  },
  "license": "MIT",
  "author": {
    "name": "xinyao",
    "email": "hi@xinyao.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinyao27/agentstart.git",
    "directory": "apps/extension"
  },
  "funding": "https://github.com/sponsors/xinyao27",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "check": "vp check --fix && vp run typecheck",
    "dev": "wxt",
    "fmt": "vp fmt .",
    "lint": "vp lint . --fix",
    "package:web-store": "vp run build && bun scripts/package-web-store.mjs",
    "package:web-store:initial": "vp run build && bun scripts/package-web-store.mjs --initial-upload",
    "typecheck": "wxt prepare && tsc --noEmit"
  },
  "dependencies": {
    "@agentstart/client": "workspace:*",
    "@agentstart/protocol": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "chrome-types": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wxt": "catalog:"
  }
}
