          "properties": {
            "url": { "type": "string" },
            "normalizedUrl": { "type": "string" },
            "title": { "type": "string" },
            "lastVisitedAt": { "type": "number" },
            "visitCount": { "type": "number" }
          },
          "required": ["url", "normalizedUrl", "title", "lastVisitedAt", "visitCount"]
        }
      },
      "activeTabIdByWorktree": {
        "type": "object",
        "propertyNames": { "type": "string" },
        "additionalProperties": { "type": ["string", "null"] }
      },
      "unifiedTabs": {
        "type": "object",
        "propertyNames": { "type": "string" },
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "entityId": { "type": "string" },
              "groupId": { "type": "string" },
              "worktreeId": { "type": "string" },
              "contentType": {
                "type": "string",
                "enum": [
                  "terminal",
                  "editor",
                  "diff",
                  "conflict-review",
                  "check-details",
                  "browser",
                  "simulator",
                  "git-graph"
                ]
              },
              "label": { "type": "string" },
              "generatedLabel": { "type": ["string", "null"] },
              "quickCommandLabel": { "type": ["string", "null"] },
              "customLabel": { "type": ["string", "null"] },
              "color": { "type": ["string", "null"] },
              "sortOrder": { "type": "number" },
              "createdAt": { "type": "number" },
              "isPreview": { "type": "boolean" },
              "isPinned": { "type": "boolean" }
            },
            "required": [
              "id",
              "entityId",
              "groupId",
              "worktreeId",
              "contentType",
              "label",
              "customLabel",
              "color",
              "sortOrder",
              "createdAt"
            ]
          }
        }
      },
      "tabGroups": {
        "type": "object",
        "propertyNames": { "type": "string" },
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "worktreeId": { "type": "string" },
              "activeTabId": { "type": ["string", "null"] },
              "tabOrder": { "type": "array", "items": { "type": "string" } },
              "recentTabIds": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["id", "worktreeId", "activeTabId", "tabOrder"]
          }
        }
      },
      "tabGroupLayouts": {
        "type": "object",
        "propertyNames": { "type": "string" },
        "additionalProperties": { "$ref": "#/$defs/__schema1" }
      },
      "activeGroupIdByWorktree": {
        "type": "object",
        "propertyNames": { "type": "string" },
        "additionalProperties": { "type": "string" }
      },
      "activeConnectionIdsAtShutdown": { "type": "array", "items": { "type": "string" } },
      "remoteSessionIdsByTabId": {
        "type": "object",
        "propertyNames": { "type": "string", "minLength": 1 },
        "additionalProperties": { "type": "string" }
      },
      "lastVisitedAtByWorktreeId": {
        "type": "object",
        "propertyNames": { "type": "string" },
        "additionalProperties": { "type": "number", "minimum": 0 }
      },
      "defaultTerminalTabsAppliedByWorktreeId": {
        "type": "object",
        "propertyNames": { "type": "string" },
        "additionalProperties": { "type": "boolean", "const": true }
      },
      "sleepingAgentSessionsByPaneKey": {
        "type": "object",
        "propertyNames": { "type": "string" },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "paneKey": { "type": "string" },
            "tabId": { "type": "string", "minLength": 1 },
            "worktreeId": { "type": "string", "minLength": 1 },
            "agent": {
              "type": "string",
              "enum": [
                "claude",
                "codex",
                "gemini",
                "antigravity",
                "opencode",
                "pi",
                "mimo-code",
                "droid",
                "grok",
                "devin",
                "omp"
              ]
            },
            "providerSession": {
              "type": "object",
              "properties": {
                "key": { "type": "string", "enum": ["session_id", "conversation_id"] },
                "id": { "type": "string", "minLength": 1, "maxLength": 512 },
                "transcriptPath": { "type": "string", "minLength": 1 }
              },
              "required": ["key", "id"]
            },
            "prompt": { "type": "string" },
            "state": { "type": "string", "enum": ["working", "blocked", "waiting", "done"] },
            "capturedAt": { "type": "number", "exclusiveMinimum": 0 },
            "updatedAt": { "type": "number", "exclusiveMinimum": 0 },
            "terminalTitle": { "type": "string" },
            "lastAssistantMessage": { "type": "string" },
            "interrupted": { "type": "boolean" },
            "connectionId": { "type": ["string", "null"] },
            "launchConfig": {
              "type": "object",
              "properties": {
                "agentCommand": { "type": "string" },
                "agentArgs": { "type": "string" },
                "agentEnv": {
                  "type": "object",
                  "propertyNames": { "type": "string" },
                  "additionalProperties": { "type": "string" }
                },
                "ompResumeFilePath": { "type": "string", "minLength": 1, "maxLength": 32768 }
              },
              "required": ["agentArgs", "agentEnv"]
            },
            "origin": { "type": "string", "enum": ["worktree-sleep", "quit", "live"] }
          },
          "required": [
            "paneKey",
            "worktreeId",
            "agent",
            "providerSession",
            "prompt",
            "state",
            "capturedAt",
            "updatedAt"
          ]
        }
      }
    },
    "required": [
      "activeRepoId",
      "activeWorktreeId",
      "activeTabId",
      "tabsByWorktree",
      "terminalLayoutsByTabId"
    ],
    "$defs": {
      "__schema0": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "const": "leaf" },
              "leafId": { "type": "string" }
            },
            "required": ["type", "leafId"]
          },
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "const": "split" },
              "direction": { "type": "string", "enum": ["vertical", "horizontal"] },
              "first": { "$ref": "#/$defs/__schema0" },
              "second": { "$ref": "#/$defs/__schema0" },
              "ratio": { "type": "number" }
            },
            "required": ["type", "direction", "first", "second"]
          }
        ]
      },
      "__schema1": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "const": "leaf" },
              "groupId": { "type": "string" }
            },
            "required": ["type", "groupId"]
          },
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "const": "split" },
              "direction": { "type": "string", "enum": ["horizontal", "vertical"] },
              "first": { "$ref": "#/$defs/__schema1" },
              "second": { "$ref": "#/$defs/__schema1" },
              "ratio": { "type": "number" }
            },
            "required": ["type", "direction", "first", "second"]
          }
        ]
      }
    }
  }
}
